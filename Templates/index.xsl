	}
</style>
	<script type="text/javascript">
		<![CDATA[

var catalogSearchResults = [];
var catalogSearchIndex = -1;


function catalogSearchKeyUp(e) {

    if (e && e.keyCode == 13) {
        catalogSearchNext();
        return;
    }

    if (e && e.keyCode == 27) {
        clearCatalogSearch();
        return;
    }

    runCatalogSearch();
}


function runCatalogSearch() {

    clearCatalogSearchMarks();

    var input = document.getElementById('catalogSearch');
    if (!input) return;

    var searchText = trimText(input.value).toLowerCase();

    if (searchText == '') {
        updateCatalogSearchCount();
        return;
    }

    var spans = document.querySelectorAll(
        '.level1, .level2, .level3, .level4, .level5'
    );

    for (var i = 0; i < spans.length; i++) {

        var text = getElementText(spans[i]).toLowerCase();

        if (text.indexOf(searchText) >= 0) {

            catalogSearchResults.push(spans[i]);

            spans[i].className += ' catalog-search-match';
        }
    }

    if (catalogSearchResults.length > 0) {

        catalogSearchIndex = 0;

        showCatalogSearchResult();
    }

    updateCatalogSearchCount();
}


function catalogSearchNext() {

    if (catalogSearchResults.length == 0) {
        runCatalogSearch();
        return;
    }

    catalogSearchIndex++;

    if (catalogSearchIndex >= catalogSearchResults.length)
        catalogSearchIndex = 0;

    showCatalogSearchResult();
}


function catalogSearchPrev() {

    if (catalogSearchResults.length == 0) {
        runCatalogSearch();
        return;
    }

    catalogSearchIndex--;

    if (catalogSearchIndex < 0)
        catalogSearchIndex = catalogSearchResults.length - 1;

    showCatalogSearchResult();
}


function showCatalogSearchResult() {

    if (catalogSearchResults.length == 0)
        return;

    for (var i = 0; i < catalogSearchResults.length; i++) {
        removeClass(catalogSearchResults[i], 'catalog-search-current');
    }

    var element = catalogSearchResults[catalogSearchIndex];

    openSearchParents(element);

    if (element.className.indexOf('catalog-search-current') < 0)
        element.className += ' catalog-search-current';

    try {
        element.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
        });
    }
    catch (e) {
        element.scrollIntoView();
    }

    updateCatalogSearchCount();
}


function openSearchParents(element) {

    var parent = element.parentNode;

    while (parent && parent != document.body) {

        if (parent.id &&
            parent.id.indexOf('inner_') == 0 &&
            parent.style.display == 'none') {

            parent.style.display = '';
        }

        parent = parent.parentNode;
    }
}


function clearCatalogSearchMarks() {

    for (var i = 0; i < catalogSearchResults.length; i++) {

        removeClass(
            catalogSearchResults[i],
            'catalog-search-match'
        );

        removeClass(
            catalogSearchResults[i],
            'catalog-search-current'
        );
    }

    catalogSearchResults = [];
    catalogSearchIndex = -1;
}


function clearCatalogSearch() {

    clearCatalogSearchMarks();

    var input = document.getElementById('catalogSearch');

    if (input) {
        input.value = '';
        input.focus();
    }

    updateCatalogSearchCount();
}


function updateCatalogSearchCount() {

    var count = document.getElementById('catalogSearchCount');

    if (!count)
        return;

    if (catalogSearchResults.length == 0) {
        count.innerHTML = '';
        return;
    }

    count.innerHTML =
        (catalogSearchIndex + 1) +
        '/' +
        catalogSearchResults.length;
}


function removeClass(element, className) {

    var reg =
        new RegExp('(^|\\s)' + className + '(\\s|$)', 'g');

    element.className =
        element.className.replace(reg, ' ');
}


function getElementText(element) {

    if (typeof element.textContent != 'undefined')
        return element.textContent;

    return element.innerText || '';
}


function trimText(text) {
    return text.replace(/^\s+|\s+$/g, '');
}

]]>
	</script>
