	}
	.level1 { font-size: 14px !important; font-weight: 700 !important; }
	.level2 { font-size: 13px !important; font-weight: 600 !important; }
	.level3, .level4, .level5 { font-size: 12px !important; font-weight: 500 !important; }

	.level1 a, .level2 a, .level3 a, .level4 a, .level5 a {
	color: #174f8f !important;
	text-decoration: none !important;
	font-family: "Segoe UI", Arial, sans-serif !important;
	}
	.level1 a:hover, .level2 a:hover, .level3 a:hover,
	.level4 a:hover, .level5 a:hover {
	color: #0d4385 !important;
	text-decoration: underline !important;
	}

	/* Each legacy row/div */
	.BodyIndex div[style*="right="] {
	min-height: 31px;
	display: flex;
	align-items: center;
	flex-direction: row;
	gap: 7px;
	box-sizing: border-box;
	padding: 4px 8px;
	margin: 2px 0;
	background: #fff;
	border: 1px solid #e0e8f1;
	border-radius: 7px;
	}
	.BodyIndex div[style*="right="]:hover {
	background: #eef5ff;
	border-color: #c7d9ee;
	}

	/* Existing folder/page/item GIFs */
	.BodyIndex div[style*="right="] > img {
	width: 18px;
	height: 18px;
	object-fit: contain;
	cursor: pointer;
	flex: 0 0 auto;
	}

	/* Nested levels get a subtle visual hierarchy */
	.BodyIndex div[style*="right=40"] { background: #fbfcfe; }
	.BodyIndex div[style*="right=60"],
	.BodyIndex div[style*="right=80"],
	.BodyIndex div[style*="right=100"] { background: #fcfdff; }

	/* Hide the old decorative underline spacing */
	.underLine {
	border: 0 !important;
	height: 0 !important;
	margin: 0 !important;
	padding: 0 !important;
	}
	.underLine br { display: none; }

	/* Scrollbar */
	body::-webkit-scrollbar { width: 10px; height: 10px; }
	body::-webkit-scrollbar-track { background: #eef3f8; }
	body::-webkit-scrollbar-thumb {
	background: #b9c9dc;
	border-radius: 10px;
	border: 2px solid #eef3f8;
	}
	body::-webkit-scrollbar-thumb:hover { background: #91aac6; }

	/* ===== RTL tree hierarchy ===== */
	html, body, .BodyIndex {
	direction: rtl !important;
	text-align: right !important;
	}

	/* The legacy XSL outputs text before the image.
	order:-1 makes the icon the first/right-most element. */
	.BodyIndex div[style*="right="] {
	direction: rtl !important;
	text-align: right !important;
	flex-direction: row !important;
	justify-content: flex-start !important;
	width: auto !important;
	}

	.BodyIndex div[style*="right="] > img {
