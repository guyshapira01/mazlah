<style type="text/css">
html, body {
    margin: 0;
    padding: 0;
    background: #f4f7fb;
    color: #13213c;
    font-family: "Segoe UI", Arial, sans-serif;
}
.BodyIndex {
    margin: 0 !important;
    padding: 14px !important;
    box-sizing: border-box;
    background: #f4f7fb !important;
    font-family: "Segoe UI", Arial, sans-serif !important;
}

/* Catalog title */
.index-header {
    width: 100%;
    min-height: 58px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    direction: rtl;
    padding: 0 18px;
    margin-bottom: 14px;
    color: #fff;
    background: linear-gradient(to bottom, #185aa8, #0d4385);
    border: 1px solid #0b3971;
    border-radius: 10px;
    box-shadow: 0 3px 12px rgba(20,48,85,.14);
}
.index-title-wrap {
    display: flex;
    align-items: center;
    gap: 11px;
}
.index-title-icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,.14);
    font-size: 20px;
}
.index-title-label {
    color: #cfe3fb;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 2px;
}
.index-title {
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.15;
}
.index-subtitle {
    color: #d9e9fb;
    font-size: 12px;
    font-weight: 500;
}

/* Legacy tree table generated by tree.js */
.BodyIndex table:not(.index-header-table) {
    border-collapse: separate;
    border-spacing: 10px 0;
}
.BodyIndex table:not(.index-header-table) td {
    vertical-align: top;
}

/* Tree items */
.level1, .level2, .level3, .level4, .level5 {
    display: inline-block;
    box-sizing: border-box;
    font-family: "Segoe UI", Arial, sans-serif !important;
    color: #183b66 !important;
    line-height: 1.45;
    border-radius: 6px;
    transition: background-color .12s ease, color .12s ease;
}
.level1 { font-size: 14px !important; font-weight: 700 !important; }
.level2 { font-size: 13px !important; font-weight: 600 !important; }
.level3, .level4, .level5 { font-size: 12px !important; font-weight: 500 !important; }

.level1 a, .level2 a, .level3 a, .level4 a, .level5 a {
    color: #174f8f !important;
    text-decoration: none !important;
    font-family: "Segoe UI", Arial, sans-serif !important;
}
.level1 a:hover, .level2 a:hover, .level3 a:hover,
.level4 a:hover, .level5 a:hover {
    color: #0d4385 !important;
    text-decoration: underline !important;
}

/* Each legacy row/div */
.BodyIndex div[style*="right="] {
    min-height: 31px;
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 7px;
    box-sizing: border-box;
    padding: 4px 8px;
    margin: 2px 0;
    background: #fff;
    border: 1px solid #e0e8f1;
    border-radius: 7px;
}
.BodyIndex div[style*="right="]:hover {
    background: #eef5ff;
    border-color: #c7d9ee;
}

/* Existing folder/page/item GIFs */
.BodyIndex div[style*="right="] > img {
    width: 18px;
    height: 18px;
    object-fit: contain;
    cursor: pointer;
    flex: 0 0 auto;
}

/* Nested levels get a subtle visual hierarchy */
.BodyIndex div[style*="right=40"] { background: #fbfcfe; }
.BodyIndex div[style*="right=60"],
.BodyIndex div[style*="right=80"],
.BodyIndex div[style*="right=100"] { background: #fcfdff; }

/* Hide the old decorative underline spacing */
.underLine {
    border: 0 !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
}
.underLine br { display: none; }

/* Scrollbar */
body::-webkit-scrollbar { width: 10px; height: 10px; }
body::-webkit-scrollbar-track { background: #eef3f8; }
body::-webkit-scrollbar-thumb {
    background: #b9c9dc;
    border-radius: 10px;
    border: 2px solid #eef3f8;
}
body::-webkit-scrollbar-thumb:hover { background: #91aac6; }

/* ===== RTL tree hierarchy ===== */
html, body, .BodyIndex {
    direction: rtl !important;
    text-align: right !important;
}

/* The legacy XSL outputs text before the image.
   order:-1 makes the icon the first/right-most element. */
.BodyIndex div[style*="right="] {
    direction: rtl !important;
    text-align: right !important;
    flex-direction: row !important;
    justify-content: flex-start !important;
    width: auto !important;
}

.BodyIndex div[style*="right="] > img {
    order: -1 !important;
    margin: 0 0 0 5px !important;
}

/* Clear visual hierarchy: 24px indentation for every nested level */
.BodyIndex div[style*="right=20"] {
    margin-right: 0 !important;
}
.BodyIndex div[style*="right=40"] {
    margin-right: 24px !important;
}
.BodyIndex div[style*="right=60"] {
    margin-right: 48px !important;
}
.BodyIndex div[style*="right=80"] {
    margin-right: 72px !important;
}
.BodyIndex div[style*="right=100"] {
    margin-right: 96px !important;
}

/* Nested levels: subtle hierarchy guide */
.BodyIndex div[style*="right=40"],
.BodyIndex div[style*="right=60"],
.BodyIndex div[style*="right=80"],
.BodyIndex div[style*="right=100"] {
    border-right: 2px solid #d6e3f2 !important;
    padding-right: 10px !important;
}

/* Make modern PNG tree icons crisp and slightly larger */
.BodyIndex div[style*="right="] > img {
    width: 20px !important;
    height: 20px !important;
}

</style>

</HEAD>
