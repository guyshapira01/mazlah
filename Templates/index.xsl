		Page_Without_Sun = newImage("images/index/page_pic.png");

		itemOpen = newImage("images/index/itemOpen.png");
		itemClose = newImage("images/index/itemClose.png");
		Item_Without_Sun = newImage("images/index/item.png");

		preloadFlag = true;
	}
	
	getFromCookieDiv()

}	
